#!/usr/bin/env bash
set -e
APP_HOME=$( cd "${APP_HOME:-.}" && pwd -P ) || exit
JAVA_HOME=$( cd "${JAVA_HOME:-.}" 2>/dev/null && pwd -P ) || JAVA_HOME=""
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
exec "${JAVA_HOME}/bin/java" -Dorg.gradle.appname=gradlew -cp "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
